# X-06: 环境变量配置说明 —— 复制为 .env 后按需修改

# === 基础 ===
BAIZE_HOST=0.0.0.0
BAIZE_PORT=9877
BAIZE_DATA_DIR=~/.baize

# === 模型 ===
BAIZE_MODEL_CONFIG=~/.baize/models.json
BAIZE_AUTH_DB=~/.baize/auth.db
BAIZE_DEFAULT_PROVIDER=openai
BAIZE_DEFAULT_MODEL=gpt-4o

# === 执行器 ===
BAIZE_EXEC_BACKEND=local
BAIZE_EXEC_SANDBOX=danger_full_access
# BAIZE_EXEC_IMAGE=instrumentisto/nmap

# === 长期记忆 ===
# off   = 不自动召回，也不提供 memory_search 工具
# tool  = 不自动注入；agent 通过 memory_search 按需查询（默认，推荐）
# brief = 自动注入少量“可能相关”的参考摘要
BAIZE_MEMORY_MODE=tool
# auto（默认）仅在显式配置 embedding_model 时启用语义检索；
# 0/1 可强制关闭/开启。未配置模型时不会请求 /v1/embeddings。
BAIZE_EMBEDDING_ENABLED=auto
# BAIZE_EMBEDDING_MODEL=text-embedding-v4

# === 编排 ===
# 统一审计日志（默认开启；JSONL + SQLite 索引 + 哈希链）
BAIZE_AUDIT_ENABLED=1
# 审计明细保留天数；0 = 永久保留。到期清理会保留链锚点，剩余事件仍可校验。
BAIZE_AUDIT_RETENTION_DAYS=0
# 流水线编排（默认关闭；当前聚焦对话式 CTF / 渗透）
# 代码与历史 runs.db 保留，设为 1 即可恢复流水线、接收器与实例 API
BAIZE_ENABLE_PIPELINES=0
BAIZE_ORCH_MAX_PARALLEL=3
BAIZE_BLACKBOARD_MAX_NODES=5000
# 会话级墙钟预算（秒）：到时停止新波次、释放未完成 intent 并输出阶段报告
BAIZE_SESSION_DEADLINE_SECONDS=900
# 插件态势上下文注入（0 关闭；关闭后 agent 仍可调用 asmp_* 工具）
BAIZE_PLUGIN_CONTEXT_BLOCK=1

# === 日志 (B-21) ===
BAIZE_LOG_FORMAT=text
# BAIZE_LOG_FILE=/var/log/baize/baize.log
BAIZE_LOG_MAX_BYTES=10485760
BAIZE_LOG_BACKUP_COUNT=5
BAIZE_LOG_LEVEL=INFO

# === 限流 (X-01) ===
BAIZE_RATE_LIMIT=60

# === 安全 ===
# BAIZE_PRINT_TOKENS=1  # 启动时在 stdout 打印密码/令牌（仅调试用）
